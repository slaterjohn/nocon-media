{
  "name": "nocon-media",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted, offline-first media server for the YouTube channels and playlists you choose",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slaterjohn/nocon-media.git"
  },
  "homepage": "https://github.com/slaterjohn/nocon-media#readme",
  "bugs": {
    "url": "https://github.com/slaterjohn/nocon-media/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:infra": "docker compose -f compose.dev.yml up -d --wait postgres redis",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "db:generate": "pnpm --filter @nocon/database generate",
    "db:migrate": "pnpm --filter @nocon/database migrate"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nocon/database": "workspace:*",
    "@nocon/discovery": "workspace:*",
    "@nocon/media-core": "workspace:*",
    "@nocon/shared": "workspace:*",
    "@nocon/source-adapters": "workspace:*",
    "@nocon/storage-manager": "workspace:*",
    "@nocon/streaming": "workspace:*",
    "@nocon/xtream": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
