# NoConMedia configuration. Copy to .env:  cp .env.example .env
# Only POSTGRES_PASSWORD must be changed. scripts/install-pi.sh does this for you.

# ---- Compose-level -------------------------------------------------------------
# Postgres credentials (DATABASE_URL is composed from these by compose.yml).
POSTGRES_USER=nocon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nocon

# Host directories. MEDIA_PATH is the library (put your USB drive here); DATA_PATH holds
# app data (tmp, cache, secrets). Both must be writable by UID 1000.
MEDIA_PATH=./media
DATA_PATH=./data

# Published ports. 0.0.0.0 = whole LAN; use 127.0.0.1 behind a reverse proxy.
# Default stays 0.0.0.0 because Xtream/M3U clients on the LAN must reach the API port.
API_BIND=0.0.0.0
WEB_BIND=0.0.0.0
# Host-side port numbers (container ports are fixed at 3001 / 3000). API_PORT_PUBLIC is also the
# port shown to Xtream clients under External players (unless PUBLIC_XTREAM_URL is set).
API_PORT_PUBLIC=3001
WEB_PORT=3000

# Shared secret so the API trusts client-IP headers only from the bundled web proxy.
# Random, 32+ characters (openssl rand -hex 32). scripts/install-pi.sh generates it.
NOCON_PROXY_SECRET=change-me-to-a-long-random-string

# Memory limits for api and web.
API_MEMORY=512m
WEB_MEMORY=512m

# Worker limits (Pi 4/5: 2 CPUs and 1 GB is a sensible start).
WORKER_CPUS=2.0
WORKER_MEMORY=1g

# Image tag, and the yt-dlp version baked into the worker image at build time.
NOCON_VERSION=latest
YTDLP_VERSION=2026.10.26

# ---- Application (packages/shared/src/config.ts) -------------------------------
# NODE_ENV is forced to production by compose.
LOG_LEVEL=info
# Public URL of the web UI as users type it, e.g. https://media.example.com. The API also accepts
# browser requests whose Origin matches it (CSRF origin check) when the Host header does not, for
# example behind a proxy that rewrites Host. Include the scheme and port, no trailing slash.
APP_URL=http://localhost:3000
# Extra browser origins accepted by the same check, comma-separated, e.g. https://media.example.com,https://nocon.lan
ALLOWED_ORIGINS=
# API_HOST / API_PORT are fixed by compose (0.0.0.0:3001 in the container).
# DATABASE_URL / REDIS_URL are composed by compose.yml (postgres:5432, redis:6379).
# Set them here only when running outside compose.

# Paths inside the containers. Leave as-is unless you change the mounts in compose.yml.
# MEDIA_ROOT is the folder the setup wizard pre-fills for the library.
MEDIA_ROOT=/media
# Comma-separated roots the setup wizard and Storage page may use for libraries. compose.yml passes
# this through, so changing it here takes effect after "docker compose up -d".
MEDIA_ROOTS_ALLOWED=/media
# DATA_ROOT (/data) is fixed by compose.yml: it holds cache, tmp and per-source cookies (secrets/).

# lightweight (Pi, default) or standard (more concurrency, thumbnails, pre-transcode).
# This is only the default: once the setup wizard or Settings saves a profile, that choice wins.
DEPLOYMENT_PROFILE=lightweight
# Override the profile concurrency (leave empty to use the profile default). These beat the profile.
MAX_CONCURRENT_DOWNLOADS=
MAX_CONCURRENT_PROCESSING=
MAX_CONCURRENT_METADATA=

# ---- Storage and retention -----------------------------------------------------
# Start evicting low-priority media above this % used; keep at least this % free.
STORAGE_SOFT_THRESHOLD=85
STORAGE_MIN_FREE_PERCENT=5
# Priority codes: P0 Protected, P1 Keep, P2 Optional, P3 Spare.
DEFAULT_SOURCE_PRIORITY=P1
# all | none | latest_n | last_days | quota | rolling | prefer_unwatched
DEFAULT_SOURCE_RETENTION=all
DEFAULT_SOURCE_AUTO_EVICTION=true
REDOWNLOAD_COOLDOWN_DAYS=30
# Testing only: pretend a volume has this capacity (bytes). Leave empty.
STORAGE_STATFS_OVERRIDE_BYTES=

# ---- Media clients -------------------------------------------------------------
ENABLE_XTREAM=true
ENABLE_M3U=true
ENABLE_HLS=true
# Comma-separated CIDRs allowed to use Xtream/M3U. Empty = private/LAN ranges only.
XTREAM_ALLOWED_CIDRS=
# Public base URL handed to Xtream clients, e.g. http://nocon.local:3001. Empty = the host the
# page was opened on (X-Forwarded-Host behind the bundled web proxy) plus API_PORT_PUBLIC.
PUBLIC_XTREAM_URL=

# ---- Reverse proxy / cookies ---------------------------------------------------
# WARNING: only enable when a reverse proxy sits in front of the API port and API_BIND is
# 127.0.0.1 or the port is firewalled; otherwise clients can spoof X-Forwarded-For.
TRUST_PROXY=false
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-* headers are trusted when TRUST_PROXY=true,
# e.g. 172.16.0.0/12,192.168.1.10. Empty = trust any hop (only safe if the API port is not reachable directly).
TRUSTED_PROXY_CIDRS=
# true when served over HTTPS.
COOKIE_SECURE=false

# ---- Downloader tools ----------------------------------------------------------
YTDLP_PATH=yt-dlp
# WARNING: passed to yt-dlp verbatim, so options such as --exec run commands in the worker.
# Only set values you trust. Example: --sleep-requests 1
YTDLP_EXTRA_ARGS=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Scheduling and connectivity -----------------------------------------------
# Comma-separated URLs probed to decide whether the server is online.
CONNECTIVITY_CHECK_URLS=https://www.youtube.com/generate_204,https://www.google.com/generate_204,https://1.1.1.1/
CONNECTIVITY_INTERVAL_SEC=60
SCHEDULER_INTERVAL_SEC=60
# true on all but one worker if you ever run several.
WORKER_DISABLE_SCHEDULER=false
